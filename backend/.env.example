# Security Agency ERP - Backend Environment Configuration Example
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=security_agency_erp
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=security_erp

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT Token Lifetime Settings
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Web Session Idle & Absolute Timeout
WEB_IDLE_MINUTES=30
WEB_ABSOLUTE_HOURS=12

# Agency Domain & Metadata
AGENCY_DOMAIN=localhost:8000
AGENCY_NAME=Security Agency Management System
TIME_ZONE=Asia/Kolkata

